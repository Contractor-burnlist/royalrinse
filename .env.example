# Basic Auth for the internal /ops page. If either is missing, /ops is closed to everyone.
# Set real values in .env.local (local) and in the Vercel project settings (deployed).
OPS_USER=
OPS_PASSWORD=

# Free CARTO basemaps key for the /ops map (carto.com/basemaps/apikey).
# Without it the map tiles show a watermark. Read at build time, so redeploy after setting it.
NEXT_PUBLIC_CARTO_KEY=
